# ================================================================
# PARKIT FRONT-DESKTOP — environment variables
# ================================================================
# Manten dos archivos: .env.local (desarrollo) y .env.production
# (despliegue). Los Makefile copian el correcto a .env antes de
# correr: `make dev` -> .env.local, `make prod` -> .env.production.
# Ambos estan en .gitignore.
#
# Copia este template:
#   cp .env.example .env.local
#   cp .env.example .env.production
# y ajusta los valores en cada uno.
# ================================================================

# OpenAPI source for automatic API type generation (used by make sync-types)
OPENAPI_URL="http://localhost:3000/api-json"

# Parkit backend base URL (REST).
# Local:      http://localhost:3000
# Production: https://backend-148077191985.southamerica-east1.run.app
VITE_API_URL="http://localhost:3000"

# Supabase project URL (base, sin /rest/v1/).
# Local:      http://127.0.0.1:54321
# Production: https://<project-ref>.supabase.co
VITE_SUPABASE_URL="http://127.0.0.1:54321"

# Supabase publishable / anon key (segura para clientes).
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx"

# ================================================================
# Sidecars (camera + LPR) — supervisión de servicios por Electron
# ================================================================
# Electron resuelve cómo arrancar los servicios Python en este orden
# (ver electron/serviceRuntime.ts):
#   1. PARKIT_MANAGE_SERVICES=0  -> Electron NO los gestiona (los corre
#      otro: `make dev`, un debugger, un host remoto).
#   2. PARKIT_LPR_CMD / PARKIT_CAMERA_CMD -> comando de arranque explícito
#      (el puerto se agrega como último argumento).
#   3. App empaquetada -> binario en process.resourcesPath.
#   4. Sin empaquetar -> venv `python main.py` desde fuente; si no hay
#      venv, cae a services/<svc>/dist/<name> compilado.
# `app.isPackaged` solo elige el default de los pasos 3/4; no es un
# interruptor de si hay supervisión. Para probar el binario compilado
# sin empaquetar, forzalo con PARKIT_<SVC>_CMD.
#
# PARKIT_MANAGE_SERVICES="1"
# PARKIT_SERVICES_DIR="/ruta/al/repo/front-desktop/services"
# PARKIT_LPR_CMD="/abs/otra/build/lpr-service"
# PARKIT_CAMERA_CMD="/abs/venv/bin/python /abs/services/camera/main.py"
