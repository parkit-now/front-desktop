{
  "name": "@parkit-now/front-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "front-desktop frontend (desktop)",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"bun run dev:renderer\" \"bun run dev:main\" \"bun run dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on dist/main/main.js tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electronmon dist/main/main.js",
    "build": "bun run build:renderer && bun run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.{ts,cts}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,html}\"",
    "sync-types": "node scripts/sync-types.mjs",
    "prepack": "node scripts/check-services.mjs",
    "pack": "bun run build && electron-builder --dir",
    "predist": "node scripts/check-services.mjs",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && node scripts/check-services.mjs mac && electron-builder --mac",
    "dist:win": "bun run build && node scripts/check-services.mjs win && electron-builder --win",
    "dist:linux": "bun run build && node scripts/check-services.mjs linux && electron-builder --linux",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "build": {
    "appId": "com.parkit.desktop",
    "productName": "Parkit",
    "publish": null,
    "protocols": [
      {
        "name": "Parkit",
        "schemes": [
          "parkit"
        ]
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "services/lpr/dist",
        "to": ".",
        "filter": [
          "lpr-service",
          "lpr-service.exe"
        ]
      },
      {
        "from": "services/camera/dist",
        "to": ".",
        "filter": [
          "camera-service",
          "camera-service.exe"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    }
  },
  "electronmon": {
    "patterns": [
      "!services",
      "!services/**/*",
      "!**/*.db",
      "!**/*.db-wal",
      "!**/*.db-shm",
      "!**/*.log",
      "!**/*.pid",
      "!**/images/**"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.1",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electronmon": "^2.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
