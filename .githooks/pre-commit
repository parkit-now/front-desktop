#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
export PATH="$PWD/node_modules/.bin:$HOME/.bun/bin:$PATH"

# Prettier corre SOLO sobre los archivos staged.
# Antes corria `bun run format` (todo el repo): pisaba archivos generados como
# CHANGELOG.md (lo escribe semantic-release) y dejaba modificados archivos
# ajenos al commit.
# NUL-delimited while-read instead of `mapfile -d ''`: mapfile needs bash >=4,
# and macOS ships bash 3.2 as /usr/bin/env bash unless a newer one is on PATH.
FILES=()
while IFS= read -r -d '' file; do
  [[ -n "$file" && -f "$file" ]] || continue
  case "$file" in
    *.ts | *.tsx | *.js | *.mjs | *.cjs | *.cts | *.json | *.md | *.css | *.html)
      FILES+=("$file")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#FILES[@]} -gt 0 ]]; then
  echo "→ Prettier (${#FILES[@]} archivo/s staged)"
  prettier --write --ignore-unknown "${FILES[@]}"
  git add -- "${FILES[@]}"
else
  echo "→ Prettier (sin archivos staged para formatear)"
fi

echo "→ ESLint"
bun run lint

echo "✓ Pre-commit OK"
